menu "PNAAT connectivity"
config PNAAT_MQTT_ENABLE
    bool "Enable Wi-Fi + MQTT"
    default y
config PNAAT_WIFI_SSID
    string "Wi-Fi SSID"
    default ""
    depends on PNAAT_MQTT_ENABLE
config PNAAT_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""
    depends on PNAAT_MQTT_ENABLE
config PNAAT_MQTT_BROKER_URI
    string "MQTT broker URI (mqtt://host:1883)"
    default "mqtt://192.168.1.100:1883"
    depends on PNAAT_MQTT_ENABLE
config PNAAT_MQTT_TOPIC
    string "MQTT telemetry topic"
    default "pnaat/ventilador/telemetria"
    depends on PNAAT_MQTT_ENABLE
config PNAAT_MQTT_AUTH
    bool "Broker requires username/password"
    default n
    depends on PNAAT_MQTT_ENABLE
config PNAAT_MQTT_USERNAME
    string "MQTT username"
    default ""
    depends on PNAAT_MQTT_AUTH
config PNAAT_MQTT_PASSWORD
    string "MQTT password"
    default ""
    depends on PNAAT_MQTT_AUTH
endmenu
