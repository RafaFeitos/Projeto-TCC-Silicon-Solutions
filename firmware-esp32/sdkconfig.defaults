# Runtime timing for 100 Hz sensor acquisition
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# BNO085 wiring defaults for Heltec WiFi LoRa 32 V3
CONFIG_BNO085_I2C_ADDR=0x4A
CONFIG_BNO085_I2C_PORT=1
CONFIG_BNO085_SDA_GPIO=6
CONFIG_BNO085_SCL_GPIO=7
CONFIG_BNO085_RESET_GPIO=4
CONFIG_BNO085_INT_GPIO=5
